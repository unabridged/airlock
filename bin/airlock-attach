#!/bin/zsh
# Airlock — integrated-terminal attach client.
#
# Run this once in Claude Desktop's integrated terminal and leave it running.
# It idles until the bridge's `open_terminal` creates the tmux session, then
# attaches so the human watches (and can type into) the same PTY Claude
# drives. When the session closes, the client returns to idling and
# auto-attaches to the next one. Ctrl-C quits the client itself.
#
# The socket is the bridge's private one — never the user's default tmux
# server. Attaching never starts a server, so no -f config is needed here.
SOCKET_PATH="$HOME/.local/state/airlock/tmux.sock"
SESSION_NAME="airlock"
FINAL_SCREEN_PATH="$HOME/.local/state/airlock/final-screen"

announced_waiting=false
while true; do
  if tmux -S "$SOCKET_PATH" has-session -t "$SESSION_NAME" 2>/dev/null; then
    echo "airlock: session opened — attaching."
    tmux -S "$SOCKET_PATH" attach-session -t "$SESSION_NAME"
    # The tmux client clears the screen unconditionally when it exits. The
    # bridge saves the pane's final screen just before closing the session
    # (and deletes it when a new one starts), so a present file means this
    # attach ended in a close — repaint it so the session content survives.
    if [[ -f "$FINAL_SCREEN_PATH" ]]; then
      printf '\033[H\033[2J'
      cat -- "$FINAL_SCREEN_PATH"
      printf '\n[airlock] session closed — its final screen is restored above.\n'
    fi
    # A deliberate detach while the session lives means "stop watching this
    # one": drain until it ends so we only auto-attach the NEXT session.
    while tmux -S "$SOCKET_PATH" has-session -t "$SESSION_NAME" 2>/dev/null; do
      sleep 2
    done
    announced_waiting=false
  fi
  if [[ $announced_waiting == false ]]; then
    echo "airlock: waiting for a session (Ctrl-C to quit)…"
    announced_waiting=true
  fi
  sleep 1
done
